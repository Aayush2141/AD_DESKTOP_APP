{
  "name": "pg-dissertation-management-system",
  "version": "1.0.0",
  "description": "PG Dissertation Management System - Ministry of AYUSH, Smart Education",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "dev": "concurrently \"vite\" \"sh scripts/start-electron.sh\"",
    "start-electron": "sh scripts/start-electron.sh",
    "build:vite": "vite build",
    "build": "vite build",
    "seed": "electron electron/db/seed-runner.js",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "gov.ayush.pgdms",
    "productName": "PG Dissertation Management System",
    "compression": "maximum",
    "electronLanguages": [
      "en"
    ],
    "afterPack": "scripts/clean-framework-locales.js",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!src/**/*",
      "!scripts/**/*",
      "!data/**/*",
      "!README.md"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "format": "ULFO"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/build/Release/**"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
